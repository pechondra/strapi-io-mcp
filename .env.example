# Base URL of your Strapi instance (no trailing slash)
STRAPI_URL=http://localhost:1337

# API token from Strapi admin panel: Settings → API Tokens
# Either set this OR provide STRAPI_EMAIL + STRAPI_PASSWORD for users-permissions JWT.
STRAPI_API_TOKEN=

# Optional: users-permissions plugin login (alternative to API token)
STRAPI_EMAIL=
STRAPI_PASSWORD=

# Optional: timeout in milliseconds (default: 30000)
STRAPI_TIMEOUT_MS=30000
